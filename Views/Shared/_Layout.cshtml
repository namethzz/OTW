<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — OTW.SHOP" : "OTW.SHOP")</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />

    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #f9f9f7;
            color: #1a1a1a;
            margin: 0;
        }

        /* ── Top Banner ── */
        .top-banner {
            background: #1a1a1a;
            color: #fff;
            padding: 8px 16px;
            font-size: .8rem;
            text-align: center;
        }
        .top-banner .signup-link {
            color: #fbbf24;
            font-weight: 600;
            text-decoration: none;
            margin-left: 6px;
        }
        .top-banner .signup-link:hover { text-decoration: underline; }

        /* ── Navbar ── */
        .site-nav {
            background: #fff;
            border-bottom: 1px solid #ebebeb;
            position: sticky;
            top: 0;
            z-index: 1000;
            height: 62px;
        }
        .site-nav > .container {
            height: 100%;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-brand {
            font-size: 1.1rem;
            font-weight: 800;
            color: #1a1a1a;
            text-decoration: none;
            letter-spacing: -.5px;
            flex-shrink: 0;
        }
        .nav-brand:hover { color: #1a1a1a; }
        .nav-brand span { color: #888; font-weight: 400; }

        .nav-center {
            display: flex;
            align-items: center;
            gap: 2px;
            list-style: none;
            margin: 0 0 0 24px;
            padding: 0;
            flex: 1;
        }
        .nav-center a {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 6px 11px;
            font-size: .845rem;
            color: #555;
            text-decoration: none;
            border-radius: 8px;
            white-space: nowrap;
            transition: background .15s, color .15s;
        }
        .nav-center a:hover { background: #f3f3f3; color: #1a1a1a; }
        .nav-center .admin-link { color: #dc2626; font-weight: 600; }
        .nav-center .admin-link:hover { background: #fef2f2; }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .nav-search { position: relative; }
        .nav-search svg {
            position: absolute;
            left: 10px; top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            pointer-events: none;
        }
        .nav-search input {
            border: 1px solid #e8e8e8;
            border-radius: 9px;
            padding: 7px 12px 7px 32px;
            font-size: .8rem;
            width: 180px;
            background: #f7f7f7;
            outline: none;
            transition: border-color .15s, width .2s;
            color: #1a1a1a;
        }
        .nav-search input:focus { border-color: #aaa; background: #fff; width: 220px; }
        .nav-search input::placeholder { color: #bbb; }

        .nav-cart {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 13px;
            border: 1px solid #e4e4e4;
            border-radius: 9px;
            font-size: .8rem;
            font-weight: 500;
            color: #1a1a1a;
            text-decoration: none;
            background: #fff;
            white-space: nowrap;
            transition: border-color .15s;
        }
        .nav-cart:hover { border-color: #aaa; color: #1a1a1a; }
        .cart-dot {
            position: absolute;
            top: -5px; right: -5px;
            background: #ef4444;
            color: #fff;
            font-size: .6rem;
            font-weight: 700;
            min-width: 17px;
            height: 17px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 3px;
            border: 2px solid #fff;
        }

        .user-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px 4px 4px;
            border: 1px solid #eee;
            border-radius: 20px;
            background: #f8f8f8;
        }
        .user-avatar {
            width: 26px; height: 26px;
            border-radius: 50%;
            background: #1a1a1a;
            color: #fff;
            font-size: .7rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .user-name {
            font-size: .8rem;
            font-weight: 500;
            max-width: 90px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .btn-login {
            padding: 7px 14px;
            border: 1px solid #e4e4e4;
            border-radius: 9px;
            font-size: .8rem;
            font-weight: 500;
            color: #444;
            text-decoration: none;
            white-space: nowrap;
            transition: border-color .15s, color .15s;
        }
        .btn-login:hover { border-color: #aaa; color: #1a1a1a; }

        .btn-register {
            padding: 7px 16px;
            border-radius: 9px;
            font-size: .8rem;
            font-weight: 600;
            color: #fff;
            text-decoration: none;
            background: #1a1a1a;
            white-space: nowrap;
            transition: background .15s;
        }
        .btn-register:hover { background: #333; color: #fff; }

        .btn-logout {
            padding: 7px 13px;
            border: 1px solid #fecaca;
            border-radius: 9px;
            font-size: .8rem;
            font-weight: 500;
            color: #dc2626;
            text-decoration: none;
            white-space: nowrap;
            transition: background .15s;
        }
        .btn-logout:hover { background: #fef2f2; }

        .nav-toggler {
            display: none;
            background: none;
            border: 1px solid #e4e4e4;
            border-radius: 8px;
            padding: 6px 9px;
            cursor: pointer;
            color: #333;
            margin-left: auto;
            flex-shrink: 0;
        }

        /* mobile */
        .mobile-menu {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,.45);
            z-index: 2000;
        }
        .mobile-menu.open { display: block; }
        .mobile-panel {
            position: absolute;
            top: 0; left: 0;
            width: 280px; height: 100%;
            background: #fff;
            padding: 20px 16px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .mobile-brand {
            font-size: 1.1rem;
            font-weight: 800;
            color: #1a1a1a;
            text-decoration: none;
            letter-spacing: -.5px;
            margin-bottom: 14px;
            display: block;
        }
        .mobile-brand span { color: #888; font-weight: 400; }
        .mobile-divider { border: none; border-top: 1px solid #f0f0f0; margin: 6px 0; }
        .mobile-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: .875rem;
            color: #444;
            text-decoration: none;
            transition: background .15s;
        }
        .mobile-link:hover { background: #f5f5f5; color: #1a1a1a; }
        .mobile-link.red { color: #dc2626; }
        .mobile-link.red:hover { background: #fef2f2; }
        .mobile-search {
            display: flex;
            border: 1px solid #e4e4e4;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 10px;
        }
        .mobile-search input {
            flex: 1;
            border: none;
            padding: 9px 12px;
            font-size: .875rem;
            outline: none;
            background: #f8f8f8;
        }
        .mobile-search button {
            background: #1a1a1a;
            border: none;
            padding: 0 14px;
            color: #fff;
            cursor: pointer;
        }

        /* user dropdown */
        .user-dropdown { position: relative; }
        .user-chip {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 4px 10px 4px 4px;
            border: 1px solid #eee; border-radius: 20px;
            background: #f8f8f8; cursor: pointer;
            transition: border-color .15s, background .15s;
        }
        .user-chip:hover { border-color: #ccc; background: #f0f0f0; }
        .user-dropdown-menu {
            display: none;
            position: absolute; top: calc(100% + 8px); right: 0;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 14px;
            box-shadow: 0 8px 32px rgba(0,0,0,.10);
            min-width: 200px;
            z-index: 1100;
            overflow: hidden;
            padding: 6px;
        }
        .user-dropdown-menu.open { display: block; }
        .dropdown-header {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 10px 12px;
        }
        .dropdown-avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: #1a1a1a; color: #fff;
            font-size: .75rem; font-weight: 700;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .dropdown-sep { height: 1px; background: #f3f3f3; margin: 3px 0; }
        .dd-link {
            display: flex; align-items: center; gap: 9px;
            padding: 9px 12px; border-radius: 9px;
            font-size: .8125rem; color: #333; text-decoration: none;
            transition: background .12s, color .12s;
        }
        .dd-link:hover { background: #f5f5f5; color: #1a1a1a; }
        .dd-link.red { color: #dc2626; }
        .dd-link.red:hover { background: #fef2f2; color: #b91c1c; }

        .site-main { min-height: calc(100vh - 240px); }

        /* ── Footer ── */
        .site-footer {
            background: #1a1a1a;
            color: #666;
            padding: 48px 0 24px;
            margin-top: 4rem;
        }
        .footer-brand {
            font-size: 1.2rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: -.5px;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 6px;
        }
        .footer-brand span { color: #555; font-weight: 400; }
        .footer-tagline { font-size: .8rem; color: #555; }
        .footer-heading {
            font-size: .7rem;
            font-weight: 600;
            color: #fff;
            text-transform: uppercase;
            letter-spacing: .08em;
            margin-bottom: 14px;
        }
        .footer-links { list-style: none; padding: 0; margin: 0; }
        .footer-links li { margin-bottom: 8px; }
        .footer-links a { font-size: .8rem; color: #555; text-decoration: none; transition: color .15s; }
        .footer-links a:hover { color: #ccc; }
        .footer-sep { border-color: #2a2a2a; margin: 28px 0 18px; }
        .footer-copy { font-size: .75rem; color: #3a3a3a; }

        @@media (max-width: 991px) {
            .nav-center, .nav-actions { display: none !important; }
            .nav-toggler { display: flex !important; align-items: center; }
        }
    </style>
</head>
<body>

<!-- ── Top Banner ── -->
<div class="top-banner">
    @if (Context.Session.GetInt32("UserId") == null)
    {
        <span>Sign up and get 30% off your first order.</span>
        <a asp-controller="Account" asp-action="Register" class="signup-link">Sign Up Now →</a>
    }
    else
    {
        <span>ยินดีต้อนรับกลับมา, <strong style="color:#fff;">@Context.Session.GetString("FullName")</strong></span>
    }
</div>

<!-- ── Navbar ── -->
@{
    var cartJson2 = Context.Session.GetString("Cart");
    int cartCount2 = 0;
    if (cartJson2 != null)
    {
        var ci = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(cartJson2);
        cartCount2 = ci?.Sum(i => i.GetProperty("Quantity").GetInt32()) ?? 0;
    }
    var fullName2 = Context.Session.GetString("FullName") ?? "";
    var initials2 = fullName2.Length > 0 ? fullName2.Substring(0, 1).ToUpper() : "U";
    bool isLoggedIn2 = Context.Session.GetInt32("UserId") != null;
    bool isAdmin2 = Context.Session.GetInt32("Role") == 1;
}

<nav class="site-nav">
    <div class="container">

        <a class="nav-brand" asp-controller="Home" asp-action="Index">OTW<span>.SHOP</span></a>

        <!-- Desktop links -->
        <ul class="nav-center">
            <li>
                <a asp-controller="Shop" asp-action="Index">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    Shop
                </a>
            </li>
            <li>
                <a asp-controller="Home" asp-action="Promo">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                    โปรโมชั่น
                </a>
            </li>
            @if (isLoggedIn2)
            {
                <li>
                    <a asp-controller="Account" asp-action="Index">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        คำสั่งซื้อ
                    </a>
                </li>
                <li>
                    <a asp-controller="Account" asp-action="MyReturns">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>
                        คืนเงิน / เปลี่ยน
                    </a>
                </li>
            }
            @if (isAdmin2)
            {
                <li>
                    <a asp-controller="Admin" asp-action="Dashboard" class="admin-link">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        Admin
                    </a>
                </li>
            }
        </ul>

        <!-- Desktop right -->
        <div class="nav-actions">
            <form class="nav-search" asp-controller="Shop" asp-action="Index" method="get">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="search" placeholder="ค้นหาสินค้า..." />
            </form>

            <a asp-controller="Shop" asp-action="Cart" class="nav-cart">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                ตะกร้า
                @if (cartCount2 > 0)
                {
                    <span class="cart-dot">@cartCount2</span>
                }
            </a>

            @if (!isLoggedIn2)
            {
                <a asp-controller="Account" asp-action="Login" class="btn-login">เข้าสู่ระบบ</a>
                <a asp-controller="Account" asp-action="Register" class="btn-register">สมัครสมาชิก</a>
            }
            else
            {
                <div class="user-dropdown" id="userDropdown">
                    <button class="user-chip" onclick="toggleDropdown()" type="button">
                        <div class="user-avatar">@initials2</div>
                        <span class="user-name">@fullName2</span>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left:2px;color:#aaa;flex-shrink:0"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="user-dropdown-menu" id="userDropdownMenu">
                        <div class="dropdown-header">
                            <div class="dropdown-avatar">@initials2</div>
                            <div>
                                <div style="font-weight:600;font-size:.8125rem;color:#1a1a1a;">@fullName2</div>
                                <div style="font-size:.73rem;color:#aaa;">สมาชิก OTW.SHOP</div>
                            </div>
                        </div>
                        <div class="dropdown-sep"></div>
                        <a asp-controller="Home" asp-action="Profile" class="dd-link">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            โปรไฟล์ของฉัน
                        </a>
                        <a asp-controller="Account" asp-action="Index" class="dd-link">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                            ประวัติคำสั่งซื้อ
                        </a>
                        <a asp-controller="Account" asp-action="MyReturns" class="dd-link">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>
                            คืน / เปลี่ยนสินค้า
                        </a>
                        <div class="dropdown-sep"></div>
                        <a asp-controller="Account" asp-action="Logout" class="dd-link red">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                            ออกจากระบบ
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Mobile toggler -->
        <button class="nav-toggler" onclick="openMobileMenu()" aria-label="เมนู">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>

    </div>
</nav>

<!-- Mobile Drawer -->
<div class="mobile-menu" id="mobileMenu" onclick="closeMobileMenu(event)">
    <div class="mobile-panel">
        <a class="mobile-brand" asp-controller="Home" asp-action="Index">OTW<span>.SHOP</span></a>

        <form class="mobile-search" asp-controller="Shop" asp-action="Index" method="get">
            <input type="text" name="search" placeholder="ค้นหาสินค้า..." />
            <button type="submit">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
        </form>

        <hr class="mobile-divider" />
        <a asp-controller="Shop" asp-action="Index" class="mobile-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            Shop
        </a>
        <a asp-controller="Home" asp-action="Privacy" class="mobile-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            โปรโมชั่น
        </a>
        <a asp-controller="Shop" asp-action="Cart" class="mobile-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            ตะกร้าสินค้า @(cartCount2 > 0 ? $"({cartCount2})" : "")
        </a>

        @if (isLoggedIn2)
        {
            <hr class="mobile-divider" />
            <a asp-controller="Account" asp-action="Index" class="mobile-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                คำสั่งซื้อของฉัน
            </a>
            <a asp-controller="Account" asp-action="MyReturns" class="mobile-link">
