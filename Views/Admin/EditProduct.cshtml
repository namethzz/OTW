@model Project.Models.Db.Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "แก้ไขสินค้า";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fs-3 mb-1">แก้ไขสินค้า</h1>
            <p class="mb-0 text-muted">แก้ไขข้อมูลสินค้า: <strong>@Model.ProductName</strong></p>
        </div>
        <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>กลับ
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="EditProduct" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="ProductId" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">ชื่อสินค้า <span class="text-danger">*</span></label>
                    <input asp-for="ProductName" class="form-control" placeholder="เช่น Whey Protein 5lb" required />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">หมวดหมู่ <span class="text-danger">*</span></label>
                    <select asp-for="CategoryId" class="form-select" required>
                        <option value="">-- เลือกหมวดหมู่ --</option>
                        @foreach (var cat in ViewBag.Categories)
                        {
                            <option value="@cat.CategoryId">@cat.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">ราคา (บาท) <span class="text-danger">*</span></label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control"
                           placeholder="0.00" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">จำนวน Stock <span class="text-danger">*</span></label>
                    <input asp-for="Stock" type="number" min="0" class="form-control"
                           placeholder="0" required />
                </div>
                <div class="col-12">
                    <label class="form-label">รูปภาพสินค้า</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" alt="@Model.ProductName"
                                 style="max-height:150px;border-radius:8px;object-fit:cover;"
                                 id="currentImage" />
                            <div class="small text-muted mt-1">รูปปัจจุบัน (เลือกไฟล์ใหม่เพื่อเปลี่ยน)</div>
                        </div>
                    }
                    <input type="file" name="imageFile" class="form-control" accept="image/*"
                           onchange="previewImage(event)" />
                    <div class="mt-2">
                        <img id="preview" src="#" alt="preview"
                             style="display:none;max-height:150px;border-radius:8px;" />
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">รายละเอียด</label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="อธิบายสินค้า..."></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">สถานะ</label>
                    <select asp-for="Status" class="form-select">
                        <option value="1">เปิดขาย</option>
                        <option value="0">ปิดขาย</option>
                    </select>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>บันทึกการเปลี่ยนแปลง
                </button>
                <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-secondary">ยกเลิก</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
function previewImage(e) {
    const img = document.getElementById('preview');
    const file = e.target.files[0];
    if (file) {
        img.src = URL.createObjectURL(file);
        img.style.display = 'block';
        // ซ่อนรูปเดิม
        const current = document.getElementById('currentImage');
        if (current) current.style.opacity = '0.4';
    }
}
</script>
}
