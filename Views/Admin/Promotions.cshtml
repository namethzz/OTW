@model IEnumerable<Project.Models.Db.Promotion>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "โปรโมชั่น";
    var now      = DateTime.Now;
    var active   = Model.Count(p => p.Status == 1 && p.EndDate > now);
    var expired  = Model.Count(p => p.Status != 1 || p.EndDate <= now);
    var totalUsed = Model.Sum(p => p.UsageCount);
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap');
    .pm-page { font-family: 'Sora', system-ui, sans-serif; }
    :root {
        --s:#ffffff;--s2:#f8f8fa;--bd:#ebebed;
        --t1:#0d0d10;--t2:#6b6b80;--t3:#b0b0c0;
        --active-bg:#f0fdf4;--active-tx:#166534;--active-dot:#22c55e;
        --expired-bg:#f4f4f5;--expired-tx:#71717a;
        --new-bg:#eef2ff;--new-tx:#3730a3;
        --ret-bg:#fefce8;--ret-tx:#854d0e;
        --all-bg:#f0f0ff;--all-tx:#6366f1;
        --r:14px;--accent:#111113;
    }
    .pm-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;gap:16px;flex-wrap:wrap;}
    .pm-title{font-size:1.35rem;font-weight:700;color:var(--t1);letter-spacing:-.025em;margin:0 0 3px;}
    .pm-sub{font-size:.8rem;color:var(--t2);margin:0;}
    .pm-add-btn{display:inline-flex;align-items:center;gap:7px;background:var(--accent);color:#fff;border:none;border-radius:var(--r);padding:10px 18px;font-size:.8375rem;font-weight:600;font-family:'Sora',sans-serif;cursor:pointer;white-space:nowrap;transition:background .15s,transform .1s;}
    .pm-add-btn:hover{background:#333;transform:translateY(-1px);}
    .pm-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:22px;}
    .pm-stat{background:var(--s);border:1px solid var(--bd);border-radius:var(--r);padding:16px 20px;display:flex;align-items:center;gap:14px;transition:box-shadow .2s,transform .2s;}
    .pm-stat:hover{box-shadow:0 6px 24px rgba(0,0,0,.07);transform:translateY(-2px);}
    .pm-stat-icon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
    .pm-stat-num{font-size:1.6rem;font-weight:700;color:var(--t1);line-height:1;margin-bottom:2px;}
    .pm-stat-label{font-size:.73rem;color:var(--t2);font-weight:500;}
    .pm-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;}
    .pm-card{background:var(--s);border:1px solid var(--bd);border-radius:18px;overflow:hidden;transition:box-shadow .2s,transform .2s;display:flex;flex-direction:column;animation:pmIn .25s ease both;}
    .pm-card:hover{box-shadow:0 8px 28px rgba(0,0,0,.09);transform:translateY(-3px);}
    @@keyframes pmIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .pm-card:nth-child(1){animation-delay:.04s}.pm-card:nth-child(2){animation-delay:.08s}.pm-card:nth-child(3){animation-delay:.12s}.pm-card:nth-child(4){animation-delay:.16s}.pm-card:nth-child(n+5){animation-delay:.20s}
    .pm-card-accent{height:4px;width:100%;}
    .pm-card-body{padding:18px 20px;flex:1;}
    .pm-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:14px;}
    .pm-card-name{font-size:.9375rem;font-weight:700;color:var(--t1);margin:0 0 6px;line-height:1.3;}
    .pm-code{display:inline-flex;align-items:center;gap:6px;background:var(--s2);border:1px solid var(--bd);border-radius:8px;padding:3px 10px;font-size:.73rem;font-weight:700;color:var(--t2);font-family:'Courier New',monospace;letter-spacing:.04em;user-select:all;}
    .pm-badge{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:999px;font-size:.7rem;font-weight:600;white-space:nowrap;flex-shrink:0;}
    .pm-bdot{width:5px;height:5px;border-radius:50%;}
    .pm-discount-display{text-align:center;padding:14px 0 10px;border-top:1px solid var(--bd);border-bottom:1px solid var(--bd);margin-bottom:14px;}
    .pm-discount-value{font-size:2.2rem;font-weight:800;color:var(--t1);line-height:1;letter-spacing:-.04em;}
    .pm-discount-label{font-size:.73rem;color:var(--t2);margin-top:3px;}
    .pm-meta{display:flex;flex-direction:column;gap:7px;margin-bottom:14px;}
    .pm-meta-row{display:flex;align-items:center;justify-content:space-between;font-size:.79rem;}
    .pm-meta-key{color:var(--t2);display:flex;align-items:center;gap:5px;}
    .pm-meta-val{font-weight:600;color:var(--t1);}
    .pm-user-type{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:7px;font-size:.72rem;font-weight:600;}
    .pm-usage-wrap{margin-bottom:10px;}
    .pm-usage-label{display:flex;justify-content:space-between;font-size:.72rem;color:var(--t2);margin-bottom:5px;}
    .pm-usage-track{height:5px;background:var(--s2);border-radius:99px;overflow:hidden;border:1px solid var(--bd);}
    .pm-usage-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,#6366f1,#8b5cf6);}
    .pm-card-foot{padding:12px 20px;border-top:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between;background:var(--s2);}
    .pm-date-info{font-size:.73rem;color:var(--t3);}
    .pm-date-info strong{color:var(--t2);}
    .pm-del-btn{width:30px;height:30px;border-radius:8px;background:none;border:1px solid var(--bd);display:flex;align-items:center;justify-content:center;color:var(--t3);cursor:pointer;transition:background .15s,color .15s,border-color .15s;}
    .pm-del-btn:hover{background:#fff1f2;border-color:#fecdd3;color:#e11d48;}
    .pm-empty{text-align:center;padding:72px 24px;background:var(--s);border:1px solid var(--bd);border-radius:18px;}
    .pm-empty-icon{width:60px;height:60px;border-radius:50%;background:var(--s2);margin:0 auto 16px;display:flex;align-items:center;justify-content:center;color:var(--t3);}
    .pm-modal .modal-content{border:0;border-radius:20px;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.18);}
    .pm-modal .modal-header{padding:20px 24px 16px;border-bottom:1px solid var(--bd);}
    .pm-modal .modal-title{font-size:1rem;font-weight:700;font-family:'Sora',sans-serif;color:var(--t1);}
    .pm-modal .modal-body{padding:20px 24px;}
    .pm-modal .modal-footer{padding:14px 24px;border-top:1px solid var(--bd);}
    .pm-field label{font-size:.78rem;font-weight:600;color:var(--t2);margin-bottom:6px;display:block;}
    .pm-field input,.pm-field select{width:100%;border:1px solid var(--bd);border-radius:10px;padding:9px 13px;font-size:.8125rem;font-family:'Sora',sans-serif;color:var(--t1);background:var(--s);outline:none;transition:border-color .15s,box-shadow .15s;}
    .pm-field input:focus,.pm-field select:focus{border-color:#aaa;box-shadow:0 0 0 3px rgba(0,0,0,.05);}
    .pm-field .hint{font-size:.72rem;color:var(--t3);margin-top:4px;}
    .pm-field .req{color:#e11d48;}
    .pm-section-label{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--t3);margin:18px 0 12px;display:flex;align-items:center;gap:8px;}
    .pm-section-label::after{content:'';flex:1;height:1px;background:var(--bd);}
    .pm-preset-strip{display:flex;gap:8px;flex-wrap:wrap;padding:14px;background:var(--s2);border-radius:12px;margin-top:16px;}
    .pm-preset-btn{background:var(--s);border:1px solid var(--bd);border-radius:8px;padding:6px 13px;font-size:.75rem;font-weight:600;font-family:'Sora',sans-serif;color:var(--t2);cursor:pointer;transition:all .15s;}
    .pm-preset-btn:hover{border-color:var(--accent);color:var(--t1);}
    .pm-btn-cancel{background:none;border:1px solid var(--bd);border-radius:10px;padding:9px 20px;font-size:.8375rem;font-weight:500;font-family:'Sora',sans-serif;color:var(--t2);cursor:pointer;transition:background .15s;}
    .pm-btn-cancel:hover{background:var(--s2);}
    .pm-btn-save{background:var(--accent);border:none;color:#fff;border-radius:10px;padding:9px 24px;font-size:.8375rem;font-weight:600;font-family:'Sora',sans-serif;cursor:pointer;transition:background .15s;}
    .pm-btn-save:hover{background:#333;}
    @@media(max-width:768px){.pm-stats{grid-template-columns:1fr 1fr}.pm-grid{grid-template-columns:1fr}}
</style>

<div class="pm-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4 py-2" style="font-size:.8375rem;" role="alert">
            <i class="ti ti-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="pm-header">
        <div>
            <h1 class="pm-title">โปรโมชั่น</h1>
            <p class="pm-sub">จัดการโปรโมชั่นและส่วนลดสำหรับลูกค้า</p>
        </div>
        <button class="pm-add-btn" data-bs-toggle="modal" data-bs-target="#addPromoModal">
            <i class="ti ti-plus" style="font-size:15px;"></i>เพิ่มโปรโมชั่น
        </button>
    </div>

    <div class="pm-stats">
        <div class="pm-stat">
            <div class="pm-stat-icon" style="background:#f0fdf4;"><i class="ti ti-discount-2" style="color:#22c55e;"></i></div>
            <div><div class="pm-stat-num">@active</div><div class="pm-stat-label">ใช้งานได้ตอนนี้</div></div>
        </div>
        <div class="pm-stat">
            <div class="pm-stat-icon" style="background:#f4f4f5;"><i class="ti ti-clock-off" style="color:#71717a;"></i></div>
            <div><div class="pm-stat-num">@expired</div><div class="pm-stat-label">หมดอายุ / ปิดใช้งาน</div></div>
        </div>
        <div class="pm-stat">
            <div class="pm-stat-icon" style="background:#f0f0ff;"><i class="ti ti-chart-bar" style="color:#6366f1;"></i></div>
            <div><div class="pm-stat-num">@totalUsed</div><div class="pm-stat-label">ครั้งที่ถูกใช้ทั้งหมด</div></div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="pm-empty">
            <div class="pm-empty-icon"><i class="ti ti-discount-2" style="font-size:24px;"></i></div>
            <p style="font-weight:600;color:var(--t1);margin:0 0 5px;">ยังไม่มีโปรโมชั่น</p>
            <p style="font-size:.8125rem;color:var(--t2);margin:0 0 18px;">กดปุ่ม "เพิ่มโปรโมชั่น" เพื่อสร้างโปรโมชั่นแรก</p>
            <button class="pm-add-btn" data-bs-toggle="modal" data-bs-target="#addPromoModal">
                <i class="ti ti-plus"></i>เพิ่มโปรโมชั่น
            </button>
        </div>
    }
    else
    {
        <div class="pm-grid">
            @foreach (var p in Model)
            {
                var isActive = p.Status == 1 && p.EndDate > now;
                var accentColor = isActive ? "#22c55e" : "#d4d4d8";
                var utBg = p.AllowedUserType == 1 ? "var(--new-bg)" : p.AllowedUserType == 2 ? "var(--ret-bg)" : "var(--all-bg)";
                var utTx = p.AllowedUserType == 1 ? "var(--new-tx)" : p.AllowedUserType == 2 ? "var(--ret-tx)" : "var(--all-tx)";
                var utIcon = p.AllowedUserType == 1 ? "ti-user-plus" : p.AllowedUserType == 2 ? "ti-repeat" : "ti-users";
                var utLabel = p.AllowedUserType == 1 ? "ลูกค้าใหม่" : p.AllowedUserType == 2 ? "ลูกค้าเก่า" : "ทุกคน";
                var usagePct = p.TotalUsageLimit.HasValue && p.TotalUsageLimit > 0
                    ? (int)Math.Min((double)p.UsageCount / p.TotalUsageLimit.Value * 100, 100) : -1;

                <div class="pm-card">
                    <div class="pm-card-accent" style="background:@accentColor;"></div>
                    <div class="pm-card-body">
                        <div class="pm-card-top">
                            <div>
                                <div class="pm-card-name">@p.PromoName</div>
                                <span class="pm-code"><i class="ti ti-tag" style="font-size:11px;"></i>@p.PromoCode</span>
                            </div>
                            @if (isActive)
                            {
                                <span class="pm-badge" style="background:var(--active-bg);color:var(--active-tx);">
                                    <span class="pm-bdot" style="background:var(--active-dot);"></span>ใช้งานได้
                                </span>
                            }
                            else
                            {
                                <span class="pm-badge" style="background:var(--expired-bg);color:var(--expired-tx);">
                                    <span class="pm-bdot" style="background:#a1a1aa;"></span>หมดอายุ
                                </span>
                            }
                        </div>

                        <div class="pm-discount-display">
                            <div class="pm-discount-value">
                                @if (p.DiscountType == 1)
                                { <span>@p.DiscountValue<small style="font-size:1rem;font-weight:500;">%</small></span> }
                                else
                                { <span style="font-size:1.6rem;">฿@p.DiscountValue.ToString("N0")</span> }
                            </div>
                            <div class="pm-discount-label">@(p.DiscountType == 1 ? "ส่วนลดเปอร์เซ็นต์" : "ส่วนลดจำนวนเงิน")</div>
                        </div>

                        <div class="pm-meta">
                            <div class="pm-meta-row">
                                <span class="pm-meta-key"><i class="ti ti-shopping-cart" style="font-size:12px;"></i>ซื้อขั้นต่ำ</span>
                                <span class="pm-meta-val">@(p.MinOrderAmount > 0 ? $"฿{p.MinOrderAmount:N0}" : "ไม่มีขั้นต่ำ")</span>
                            </div>
                            <div class="pm-meta-row">
                                <span class="pm-meta-key"><i class="ti ti-user" style="font-size:12px;"></i>สิทธิ์</span>
                                <span class="pm-user-type" style="background:@utBg;color:@utTx;">
                                    <i class="ti @utIcon" style="font-size:11px;"></i>@utLabel
                                </span>
                            </div>
                            <div class="pm-meta-row">
                                <span class="pm-meta-key"><i class="ti ti-repeat-once" style="font-size:12px;"></i>ใช้ได้/คน</span>
                                <span class="pm-meta-val">@(p.UsageLimitPerUser.HasValue ? $"{p.UsageLimitPerUser} ครั้ง" : "ไม่จำกัด")</span>
                            </div>
                        </div>

                        @if (usagePct >= 0)
                        {
                            <div class="pm-usage-wrap">
                                <div class="pm-usage-label">
                                    <span>โควต้าที่ใช้ไป</span>
                                    <span><strong>@p.UsageCount</strong> / @p.TotalUsageLimit</span>
                                </div>
                                <div class="pm-usage-track">
                                    <div class="pm-usage-fill" style="width:@usagePct%;"></div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div style="font-size:.72rem;color:var(--t3);margin-bottom:4px;">ถูกใช้ <strong style="color:var(--t2);">@p.UsageCount</strong> ครั้ง (ไม่จำกัดโควต้า)</div>
                        }
                    </div>

                    <div class="pm-card-foot">
                        <div class="pm-date-info">
                            @if (p.StartDate.HasValue){<span>เริ่ม <strong>@p.StartDate.Value.ToString("dd/MM/yy")</strong></span><span style="margin:0 5px;">→</span>}
                            @if (p.EndDate.HasValue){<span>หมด <strong>@p.EndDate.Value.ToString("dd/MM/yy")</strong></span>}
                            else{<span style="color:var(--t3);">ไม่มีวันหมดอายุ</span>}
                        </div>
                        <button class="pm-del-btn" onclick="confirmDelete(@p.PromotionId, '@p.PromoName.Replace("'", "\\'")') ">
                            <i class="ti ti-trash" style="font-size:13px;"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Delete Modal -->
<div class="modal fade" id="pmDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-body text-center p-5">
                <div style="width:52px;height:52px;border-radius:50%;background:#fff1f2;border:1px solid #fecdd3;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
                    <i class="ti ti-trash" style="font-size:20px;color:#e11d48;"></i>
                </div>
                <h5 style="font-family:'Sora',sans-serif;font-size:1rem;font-weight:700;margin:0 0 6px;">ยืนยันการลบ?</h5>
                <p style="font-size:.8125rem;color:#6b6b80;margin:0 0 4px;">โปรโมชั่น <strong id="pmDelName" style="color:#0d0d10;"></strong></p>
                <p style="font-size:.75rem;color:#e11d48;margin:0 0 20px;">ถ้ามีออเดอร์ใช้อยู่แล้ว ระบบจะปิดใช้งานแทนการลบ</p>
                <div style="display:flex;gap:10px;justify-content:center;">
                    <button class="pm-btn-cancel" data-bs-dismiss="modal">ยกเลิก</button>
                    <a id="pmDelBtn" href="#" class="pm-btn-save" style="background:#e11d48;text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
                        <i class="ti ti-trash"></i>ลบเลย
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade pm-modal" id="addPromoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-discount-2 me-2" style="color:#6366f1;"></i>เพิ่มโปรโมชั่นใหม่</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddPromotion" method="post">
                <div class="modal-body">
                    <div class="pm-section-label">ข้อมูลพื้นฐาน</div>
                    <div class="row g-3">
                        <div class="col-md-6 pm-field">
                            <label>ชื่อโปรโมชั่น <span class="req">*</span></label>
                            <input name="PromoName" placeholder="เช่น ลูกค้าใหม่ลด 30%" required />
                        </div>
                        <div class="col-md-6 pm-field">
                            <label>รหัสโปรโมชั่น <span class="req">*</span></label>
                            <input name="PromoCode" id="promoCodeInput" placeholder="เช่น NEW30" required />
                        </div>
                    </div>
                    <div class="pm-section-label">ส่วนลด</div>
                    <div class="row g-3">
                        <div class="col-md-6 pm-field">
                            <label>ประเภทส่วนลด</label>
                            <select name="DiscountType">
                                <option value="1">เปอร์เซ็นต์ (%)</option>
                                <option value="2">จำนวนเงิน (฿)</option>
                            </select>
                        </div>
                        <div class="col-md-6 pm-field">
                            <label>มูลค่าส่วนลด <span class="req">*</span></label>
                            <input name="DiscountValue" type="number" step="0.01" min="0" placeholder="30" required />
                        </div>
                        <div class="col-md-6 pm-field">
                            <label>ยอดซื้อขั้นต่ำ (บาท)</label>
                            <input name="MinOrderAmount" type="number" step="0.01" min="0" placeholder="0 = ไม่มีขั้นต่ำ" />
                        </div>
                    </div>
                    <div class="pm-section-label">สิทธิ์และโควต้า</div>
                    <div class="row g-3">
                        <div class="col-md-6 pm-field">
                            <label>สิทธิ์ผู้ใช้</label>
                            <select name="AllowedUserType">
                                <option value="0">ทุกคน</option>
                                <option value="1">ลูกค้าใหม่เท่านั้น</option>
                                <option value="2">ลูกค้าเก่า (เคยซื้อแล้ว)</option>
                            </select>
                            <div class="hint">ลูกค้าใหม่ = ยังไม่เคยมีออเดอร์เลย</div>
                        </div>
                        <div class="col-md-6 pm-field">
                            <label>จำกัดการใช้ต่อคน (ครั้ง)</label>
                            <input name="UsageLimitPerUser" type="number" min="1" placeholder="ว่างไว้ = ไม่จำกัด" />
                            <div class="hint">โปรลูกค้าใหม่แนะนำให้ใส่ 1</div>
                        </div>
                        <div class="col-md-6 pm-field">
                            <label>โควต้าทั้งหมด (ครั้ง)</label>
                            <input name="TotalUsageLimit" type="number" min="1" placeholder="ว่างไว้ = ไม่จำกัด" />
                        </div>
                    </div>
                    <div class="pm-section-label">ระยะเวลา</div>
                    <div class="row g-3">
                        <div class="col-md-6 pm-field">
                            <label>วันเริ่มต้น</label>
                            <input name="StartDate" type="datetime-local" />
                        </div>
                        <div class="col-md-6 pm-field">
                            <label>วันสิ้นสุด</label>
                            <input name="EndDate" type="datetime-local" />
                        </div>
                    </div>
                    <div class="pm-section-label">เติมข้อมูลด่วน</div>
                    <div class="pm-preset-strip">
                        <button type="button" class="pm-preset-btn" onclick="fillPreset('ลูกค้าใหม่ลด 30%','NEW30',1,30,2000,1,1)">⚡ ลูกค้าใหม่ 30%</button>
                        <button type="button" class="pm-preset-btn" onclick="fillPreset('ซื้อเยอะลดแรง','BULK45',1,45,8000,0,null)">⚡ ซื้อเยอะ 45%</button>
                        <button type="button" class="pm-preset-btn" onclick="fillPreset('ลูกค้าเก่ากลับมา','RETURN25',1,25,0,2,1)">⚡ ลูกค้าเก่า 25%</button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="pm-btn-cancel" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="pm-btn-save"><i class="ti ti-plus me-1"></i>บันทึกโปรโมชั่น</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function fillPreset(name, code, discType, discVal, minOrder, userType, usageLimit) {
    document.querySelector('[name="PromoName"]').value = name;
    document.querySelector('[name="PromoCode"]').value = code;
    document.querySelector('[name="DiscountType"]').value = discType;
    document.querySelector('[name="DiscountValue"]').value = discVal;
    document.querySelector('[name="MinOrderAmount"]').value = minOrder;
    document.querySelector('[name="AllowedUserType"]').value = userType;
    document.querySelector('[name="UsageLimitPerUser"]').value = usageLimit ?? '';
}
function confirmDelete(id, name) {
    document.getElementById('pmDelName').textContent = name;
    document.getElementById('pmDelBtn').href = '/Admin/DeletePromotion/' + id;
    new bootstrap.Modal(document.getElementById('pmDeleteModal')).show();
}
document.getElementById('promoCodeInput')?.addEventListener('input', function() {
    this.value = this.value.toUpperCase();
});
</script>
}
