@model Project.Models.Db.Order
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "รายละเอียดคำสั่งซื้อ";

    var statusLabel = Model.OrderStatus switch {
        1 => "รอดำเนินการ",
        2 => "กำลังจัดส่ง",
        3 => "จัดส่งสำเร็จ",
        _ => "ไม่ทราบสถานะ"
    };
    var statusClass = Model.OrderStatus switch {
        1 => "bg-warning text-dark",
        2 => "bg-primary",
        3 => "bg-success",
        _ => "bg-secondary"
    };
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1">คำสั่งซื้อ #@Model.OrderId</h2>
        <p class="text-muted mb-0">วันที่สั่ง: @Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <a asp-controller="Admin" asp-action="Orders" class="btn btn-outline-secondary rounded-3">
        <i class="ti ti-arrow-left me-1"></i>กลับ
    </a>
</div>

<div class="row g-4">

    <!-- ข้อมูลลูกค้า -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:12px;letter-spacing:.05em;">
                    <i class="ti ti-user me-1"></i>ข้อมูลลูกค้า
                </h6>
                <div class="mb-2"><span class="text-muted small">ชื่อ:</span>
                    <span class="fw-semibold ms-2">@Model.User?.FullName</span>
                </div>
                <div class="mb-2"><span class="text-muted small">อีเมล:</span>
                    <span class="ms-2">@Model.User?.Email</span>
                </div>
                <div><span class="text-muted small">เบอร์โทร:</span>
                    <span class="ms-2">@(Model.User?.Phone ?? "-")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- สรุปคำสั่งซื้อ -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:12px;letter-spacing:.05em;">
                    <i class="ti ti-receipt me-1"></i>สรุปคำสั่งซื้อ
                </h6>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">สถานะ:</span>
                    <span class="badge rounded-pill @statusClass px-3">@statusLabel</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted small">โปรโมชั่น:</span>
                    <span>
                        @if (Model.Promotion != null)
                        {
                            <span class="badge text-bg-light border">@Model.Promotion.PromoCode</span>
                            <small class="text-muted ms-1">(@Model.Promotion.PromoName)</small>
                        }
                        else { <span class="text-muted">-</span> }
                    </span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between fw-bold fs-5">
                    <span>ยอดรวมสุทธิ</span>
                    <span class="text-success">฿@Model.TotalPrice.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- รายการสินค้า -->
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 py-3 px-4">
                <h5 class="fw-bold mb-0"><i class="ti ti-shopping-cart me-2"></i>รายการสินค้า</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>สินค้า</th>
                                <th class="text-center">ราคา/ชิ้น</th>
                                <th class="text-center">จำนวน</th>
                                <th class="text-end">รวม</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                            {
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                                {
                                                    <img src="@item.Product.ImageUrl"
                                                         style="width:48px;height:48px;object-fit:cover;border-radius:8px;" />
                                                }
                                                else
                                                {
                                                    <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                         style="width:48px;height:48px;">
                                                        <i class="ti ti-photo text-muted"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <div class="fw-semibold">@item.Product?.ProductName</div>
                                                    <div class="small text-muted">รหัสสินค้า: #@item.Product?.ProductId</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">฿@item.Price.ToString("N2")</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end fw-semibold">฿@((item.Price * item.Quantity).ToString("N2"))</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">ไม่มีรายการสินค้า</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">ยอดรวมสุทธิ</td>
                                <td class="text-end fw-bold text-success fs-5">฿@Model.TotalPrice.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- อัปเดตสถานะ -->
    @if (Model.OrderStatus != 3)
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center gap-3 flex-wrap">
                    <span class="fw-semibold">อัปเดตสถานะคำสั่งซื้อ:</span>
                    @if (Model.OrderStatus == 1)
                    {
                        <form asp-controller="Admin" asp-action="UpdateOrderStatus" method="post">
                            <input type="hidden" name="orderId" value="@Model.OrderId" />
                            <input type="hidden" name="status" value="2" />
                            <button type="submit" class="btn btn-primary rounded-3">
                                <i class="ti ti-truck-delivery me-1"></i>เริ่มจัดส่ง
                            </button>
                        </form>
                    }
                    else if (Model.OrderStatus == 2)
                    {
                        <form asp-controller="Admin" asp-action="UpdateOrderStatus" method="post">
                            <input type="hidden" name="orderId" value="@Model.OrderId" />
                            <input type="hidden" name="status" value="3" />
                            <button type="submit" class="btn btn-success rounded-3">
                                <i class="ti ti-circle-check me-1"></i>จัดส่งสำเร็จ
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }

</div>
