@using Project.Models.Db
@{
    Layout = "_Layout";
    ViewData["Title"] = "คำสั่งซื้อของฉัน";

    var orders    = ViewBag.Orders    as List<Order>  ?? new();
    var myReturns = ViewBag.MyReturns as List<Return> ?? new();

    // filter tab จาก query string
    var tab = Context.Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(tab)) tab = "all";

    var filtered = tab switch {
        "pending"   => orders.Where(o => o.OrderStatus == 1).ToList(),
        "shipping"  => orders.Where(o => o.OrderStatus == 2).ToList(),
        "delivered" => orders.Where(o => o.OrderStatus == 3).ToList(),
        "cancelled" => orders.Where(o => o.OrderStatus == 4).ToList(),
        _           => orders
    };
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="page-title mb-1">คำสั่งซื้อของฉัน</h2>
            <p class="text-muted mb-0" style="font-size:.875rem;">
                ทั้งหมด @orders.Count รายการ
            </p>
        </div>
        <a asp-controller="Shop" asp-action="Index" class="btn-shop-more">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            ซื้อสินค้าเพิ่ม
        </a>
    </div>

    <!-- Tab bar -->
    <div class="tab-bar mb-4">
        <a href="?tab=all"       class="tab-item @(tab=="all"       ? "active" : "")">
            ทั้งหมด
            <span class="tab-count">@orders.Count</span>
        </a>
        <a href="?tab=pending"   class="tab-item @(tab=="pending"   ? "active" : "")">
            รอดำเนินการ
            @{ var pc = orders.Count(o => o.OrderStatus == 1); }
            @if (pc > 0) { <span class="tab-count">@pc</span> }
        </a>
        <a href="?tab=shipping"  class="tab-item @(tab=="shipping"  ? "active" : "")">
            กำลังจัดส่ง
            @{ var sc = orders.Count(o => o.OrderStatus == 2); }
            @if (sc > 0) { <span class="tab-count">@sc</span> }
        </a>
        <a href="?tab=delivered" class="tab-item @(tab=="delivered" ? "active" : "")">
            จัดส่งสำเร็จ
            @{ var dc = orders.Count(o => o.OrderStatus == 3); }
            @if (dc > 0) { <span class="tab-count">@dc</span> }
        </a>
        <a href="?tab=cancelled" class="tab-item @(tab=="cancelled" ? "active" : "")">
            ยกเลิก
            @{ var cc = orders.Count(o => o.OrderStatus == 4); }
            @if (cc > 0) { <span class="tab-count">@cc</span> }
        </a>
    </div>

    <!-- Empty -->
    @if (!filtered.Any())
    {
        <div class="empty-wrap text-center py-5">
            <div class="empty-icon mx-auto mb-4">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ccc"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                </svg>
            </div>
            <h5 class="fw-semibold mb-1">ไม่มีคำสั่งซื้อ</h5>
            <p class="text-muted mb-4" style="font-size:.875rem;">
                @(tab == "all" ? "เมื่อคุณสั่งซื้อสินค้า รายการจะแสดงที่นี่" : "ไม่มีออเดอร์ในหมวดนี้")
            </p>
            <a asp-controller="Shop" asp-action="Index" class="btn-shop-more">ไปหน้าสินค้า</a>
        </div>
    }
    else
    {
        <div class="order-list">
            @foreach (var order in filtered)
            {
                var ret = myReturns
                    .Where(r => r.OrderId == order.OrderId)
                    .OrderByDescending(r => r.CreatedAt)
                    .FirstOrDefault();

                // status config
                var (statusLabel, statusClass) = order.OrderStatus switch {
                    1 => ("รอดำเนินการ", "status-pending"),
                    2 => ("กำลังจัดส่ง", "status-shipping"),
                    3 => ("จัดส่งสำเร็จ", "status-delivered"),
                    4 => ("ยกเลิก",       "status-cancelled"),
                    _ => ("ไม่ทราบ",      "status-unknown")
                };

                var (retLabel, retClass) = ret == null ? ("", "") : ret.Status switch {
                    0 => ("รอตรวจสอบ",  "ret-pending"),
                    1 => ("อนุมัติแล้ว", "ret-approved"),
                    _ => ("ไม่อนุมัติ",  "ret-rejected")
                };

                <div class="order-card mb-3">

                    <!-- Card header -->
                    <div class="order-card-head">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="order-id">#@order.OrderId</span>
                            <span class="order-date text-muted">
                                @order.OrderDate?.ToString("dd MMM yyyy · HH:mm")
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (ret != null)
                            {
                                <span class="ret-badge @retClass">@retLabel</span>
                            }
                            <span class="status-badge @statusClass">
                                @if (order.OrderStatus == 1)
                                {
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                }
                                else if (order.OrderStatus == 2)
                                {
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                                }
                                else if (order.OrderStatus == 3)
                                {
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                }
                                else
                                {
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                }
                                @statusLabel
                            </span>
                        </div>
                    </div>

                    <!-- Products list -->
                    @if (order.OrderDetails != null && order.OrderDetails.Any())
                    {
                        <div class="order-items">
                            @foreach (var item in order.OrderDetails.Take(3))
                            {
                                <div class="order-item">
                                    <div class="item-thumb">
                                        @if (!string.IsNullOrWhiteSpace(item.Product?.ImageUrl))
                                        {
                                            <img src="@item.Product.ImageUrl" alt="@item.Product?.ProductName"
                                                 style="width:100%;height:100%;object-fit:contain;padding:4px" />
                                        }
                                        else
                                        {
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ddd"
                                                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="3" y="3" width="18" height="18" rx="2"/>
                                                <circle cx="8.5" cy="8.5" r="1.5"/>
                                                <polyline points="21 15 16 10 5 21"/>
                                            </svg>
                                        }
                                    </div>
                                    <div class="item-info">
                                        <div class="item-name">@(item.Product?.ProductName ?? "-")</div>
                                        <div class="item-meta">x@item.Quantity · ฿@item.Price.ToString("N0")</div>
                                    </div>
                                    <div class="item-total">฿@((item.Price * item.Quantity).ToString("N0"))</div>
                                </div>
                            }
                            @if (order.OrderDetails.Count > 3)
                            {
                                <div class="more-items">
                                    + อีก @(order.OrderDetails.Count - 3) รายการ
                                </div>
                            }
                        </div>
                    }

                    <!-- Card footer -->
                    <div class="order-card-foot">
                        <div class="order-total">
                            <span class="text-muted" style="font-size:.8125rem;">ยอดรวม</span>
                            <span class="total-amount">฿@order.TotalPrice.ToString("N2")</span>
                        </div>
                        <div class="order-actions">
                            @if (order.OrderStatus == 3 && ret == null)
                            {
                                <a asp-controller="Return" asp-action="Create"
                                   asp-route-orderId="@order.OrderId"
                                   class="btn-return">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="1 4 1 10 7 10"/>
                                        <path d="M3.51 15a9 9 0 1 0 .49-3.51"/>
                                    </svg>
                                    ขอคืน / เปลี่ยน
                                </a>
                            }
                            <a asp-controller="Account" asp-action="OrderDetail"
                               asp-route-id="@order.OrderId"
                               class="btn-detail">
                                ดูรายละเอียด
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"/>
                                </svg>
                            </a>
                        </div>
                    </div>

                </div>
            }
        </div>
    }

</div>

<style>
.page-title { font-size: 1.4rem; font-weight: 700; color: #1a1a1a; }

/* Shop more button */
.btn-shop-more {
    display: inline-flex; align-items: center; gap: 7px;
    border: 1px solid #e0e0e0; border-radius: 10px;
    padding: 8px 16px; font-size: .8125rem; font-weight: 500;
    color: #333; text-decoration: none;
    transition: border-color .15s, background .15s;
    white-space: nowrap;
}
.btn-shop-more:hover { border-color: #1a1a1a; background: #fafafa; color: #1a1a1a; }

/* Tab bar */
.tab-bar {
    display: flex; align-items: center;
    border-bottom: 1.5px solid #f0f0f0;
    gap: 0; overflow-x: auto;
    scrollbar-width: none;
}
.tab-bar::-webkit-scrollbar { display: none; }
.tab-item {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 18px;
    font-size: .8125rem; font-weight: 500;
    color: #888; text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1.5px;
    white-space: nowrap;
    transition: color .15s, border-color .15s;
}
.tab-item:hover { color: #1a1a1a; }
.tab-item.active { color: #1a1a1a; border-bottom-color: #1a1a1a; }
.tab-count {
    background: #f0f0f0; color: #555;
    font-size: .7rem; font-weight: 600;
    padding: 1px 7px; border-radius: 20px;
    min-width: 20px; text-align: center;
}
.tab-item.active .tab-count { background: #1a1a1a; color: #fff; }

/* Empty */
.empty-icon {
    width: 80px; height: 80px; border-radius: 50%;
    background: #f5f5f5;
    display: flex; align-items: center; justify-content: center;
}

/* Order card */
.order-card {
    background: #fff;
    border-radius: 16px;
    border: 1px solid #f0f0f0;
    overflow: hidden;
    transition: box-shadow .2s;
}
.order-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,.07); }

/* Card head */
.order-card-head {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 8px;
    padding: 14px 20px;
    border-bottom: 1px solid #f5f5f5;
    background: #fafafa;
}
.order-id { font-size: .875rem; font-weight: 700; color: #1a1a1a; }
.order-date { font-size: .75rem; }

/* Status badges */
.status-badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: .72rem; font-weight: 600;
    padding: 4px 10px; border-radius: 20px;
}
.status-pending   { background: #FFF8E1; color: #8B6000; }
.status-shipping  { background: #E3F2FD; color: #0D47A1; }
.status-delivered { background: #E8F5E9; color: #2E7D32; }
.status-cancelled { background: #FFEBEE; color: #B71C1C; }
.status-unknown   { background: #f0f0f0; color: #666; }

/* Return badge */
.ret-badge {
    font-size: .72rem; font-weight: 600;
    padding: 4px 10px; border-radius: 20px;
}
.ret-pending  { background: #FFF8E1; color: #8B6000; }
.ret-approved { background: #E8F5E9; color: #2E7D32; }
.ret-rejected { background: #FFEBEE; color: #B71C1C; }

/* Order items */
.order-items { padding: 4px 20px; }
.order-item {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #f8f8f8;
}
.order-item:last-child { border-bottom: 0; }

.item-thumb {
    width: 56px; height: 56px; flex-shrink: 0;
    background: #f8f8f8; border: 1px solid #eee;
    border-radius: 10px; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
}
.item-info { flex: 1; min-width: 0; }
.item-name {
    font-size: .8125rem; font-weight: 500; color: #1a1a1a;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    margin-bottom: 3px;
}
.item-meta { font-size: .75rem; color: #999; }
.item-total { font-size: .8125rem; font-weight: 600; color: #1a1a1a; white-space: nowrap; }

.more-items {
    padding: 8px 0 10px;
    font-size: .75rem; color: #aaa; text-align: center;
}

/* Card footer */
.order-card-foot {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 12px;
    padding: 14px 20px;
    border-top: 1px solid #f5f5f5;
}
.order-total { display: flex; flex-direction: column; }
.total-amount { font-size: 1.05rem; font-weight: 700; color: #1a1a1a; }
.order-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

/* Detail button */
.btn-detail {
    display: inline-flex; align-items: center; gap: 5px;
    background: #1a1a1a; color: #fff;
    border-radius: 9px; padding: 8px 16px;
    font-size: .8125rem; font-weight: 600;
    text-decoration: none;
    transition: background .15s;
}
.btn-detail:hover { background: #333; color: #fff; }

/* Return button */
.btn-return {
    display: inline-flex; align-items: center; gap: 5px;
    border: 1px solid #e0e0e0; border-radius: 9px;
    padding: 7px 14px; font-size: .8125rem; font-weight: 500;
    color: #555; text-decoration: none;
    transition: border-color .15s, background .15s;
}
.btn-return:hover { border-color: #aaa; background: #fafafa; color: #1a1a1a; }
</style>
