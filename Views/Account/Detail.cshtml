@model Project.Models.Db.Order
@using Project.Models.Db

@{
    Layout = "_Layout";
    ViewData["Title"] = "รายละเอียดคำสั่งซื้อ";

    var returnRequest = ViewBag.ReturnRequest as Return;
    var myReviews     = ViewBag.MyReviews as List<Review> ?? new();
}

<div class="container py-5">

    <!-- Back -->
    <div class="mb-4">
        <a asp-controller="Account" asp-action="Index" class="back-link text-decoration-none text-muted d-inline-flex align-items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            กลับไปคำสั่งซื้อของฉัน
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["ReviewSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
            @TempData["ReviewSuccess"]
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ReviewError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            @TempData["ReviewError"]
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-semibold mb-1" style="font-size:1.35rem;">คำสั่งซื้อ #@Model.OrderId</h2>
            <p class="text-muted mb-0" style="font-size:.875rem;">@Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div>
            @if (Model.OrderStatus == 1)
            {
                <span class="status-badge status-pending">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                    รอดำเนินการ
                </span>
            }
            else if (Model.OrderStatus == 2)
            {
                <span class="status-badge status-shipping">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                    กำลังจัดส่ง
                </span>
            }
            else if (Model.OrderStatus == 3)
            {
                <span class="status-badge status-delivered">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    จัดส่งสำเร็จ
                </span>
            }
            else if (Model.OrderStatus == 4)
            {
                <span class="status-badge status-cancelled">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    ยกเลิก
                </span>
            }
        </div>
    </div>

    <div class="row g-4">

        <!-- ซ้าย: รายการสินค้า -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="section-title mb-4">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                        </svg>
                        รายการสินค้า
                    </h5>

                    @foreach (var item in Model.OrderDetails)
                    {
                        var myReview = myReviews.FirstOrDefault(r =>
                            r.ProductId == item.ProductId && r.OrderId == Model.OrderId);

                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 py-3 border-bottom order-product-row">

                            <!-- รูป + ชื่อ -->
                            <div class="d-flex align-items-center gap-3">
                                <div class="product-thumb d-flex align-items-center justify-content-center overflow-hidden rounded-3">
                                    @if (!string.IsNullOrWhiteSpace(item.Product?.ImageUrl))
                                    {
                                        <img src="@item.Product.ImageUrl" class="img-fluid" style="max-height:56px;object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
                                        </svg>
                                    }
                                </div>
                                <div>
                                    <div class="fw-semibold" style="font-size:.9375rem;">@(item.Product?.ProductName ?? "-")</div>
                                    <div class="text-muted" style="font-size:.8125rem;">จำนวน @item.Quantity ชิ้น &nbsp;·&nbsp; ฿@item.Price.ToString("N2") / ชิ้น</div>
                                </div>
                            </div>

                            <!-- ราคา + รีวิว -->
                            <div class="text-md-end">
                                <div class="fw-semibold mb-2" style="font-size:.9375rem;">฿@((item.Price * item.Quantity).ToString("N2"))</div>

                                @if (Model.OrderStatus == 3)
                                {
                                    if (myReview == null)
                                    {
                                        <a asp-controller="Review" asp-action="Create"
                                           asp-route-orderId="@Model.OrderId"
                                           asp-route-productId="@item.ProductId"
                                           class="btn-review">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                            </svg>
                                            เขียนรีวิว
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="reviewed-badge mb-1">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                            รีวิวแล้ว
                                        </div>
                                        <div class="star-rating">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="@(s <= myReview.Rating ? "#F5A623" : "none")" stroke="#F5A623" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                                </svg>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(myReview.Comment))
                                        {
                                            <div class="text-muted mt-1" style="font-size:.75rem;">"@myReview.Comment"</div>
                                        }
                                    }
                                }
                            </div>

                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ขวา: สรุปยอด + คืน/เปลี่ยน -->
        <div class="col-lg-4">

            <!-- สรุปยอด -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="section-title mb-3">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                            <line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/>
                            <line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                        </svg>
                        สรุปคำสั่งซื้อ
                    </h5>

                    <div class="summary-row">
                        <span class="text-muted">ยอดสินค้า</span>
                        <span>฿@Model.Subtotal.ToString("N2")</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="summary-row">
                            <span class="text-muted">ส่วนลด</span>
                            <span class="text-success">-฿@Model.DiscountAmount?.ToString("N2")</span>
                        </div>
                    }
                    @if (Model.Promotion != null)
                    {
                        <div class="summary-row align-items-center">
                            <span class="text-muted">โปรโมชั่น</span>
                            <span class="promo-badge">@Model.Promotion.PromoCode</span>
                        </div>
                    }
                    <hr class="my-3" />
                    <div class="summary-row">
                        <span class="fw-semibold">ยอดรวมสุทธิ</span>
                        <span class="fw-semibold" style="font-size:1.1rem;">฿@Model.TotalPrice.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- คืน/เปลี่ยน -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="section-title mb-3">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
                            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                        </svg>
                        คืน / เปลี่ยนสินค้า
                    </h5>

                    @if (returnRequest == null)
                    {
                        if (Model.OrderStatus == 3)
                        {
                            <p class="text-muted mb-3" style="font-size:.8125rem;">
                                หากสินค้ามีปัญหาหรือไม่ตรงตามที่สั่ง สามารถยื่นคำขอได้ภายใน 7 วันนับจากวันที่ได้รับสินค้า
                            </p>
                            <a asp-controller="Return" asp-action="Create"
                               asp-route-orderId="@Model.OrderId"
                               class="btn btn-warning w-100 rounded-3 fw-semibold d-flex align-items-center justify-content-center gap-2">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
                                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                                </svg>
                                ยื่นขอคืน / เปลี่ยนสินค้า
                            </a>
                        }
                        else
                        {
                            <p class="text-muted mb-0" style="font-size:.8125rem;">
                                จะยื่นคำขอได้หลังจากออเดอร์จัดส่งสำเร็จแล้วเท่านั้น
                            </p>
                        }
                    }
                    else
                    {
                        <div class="return-meta mb-2">
                            <span class="return-label">ประเภทคำขอ</span>
                            <div class="return-value">@returnRequest.ReturnType</div>
                        </div>
                        <div class="return-meta mb-3">
                            <span class="return-label">เหตุผล</span>
                            <div class="return-value">@returnRequest.Reason</div>
                        </div>

                        @if (returnRequest.Status == 0)
                        {
                            <div class="return-status return-status-pending">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                </svg>
                                <div>
                                    <div class="return-status-title">รอตรวจสอบ</div>
                                    <div class="return-status-desc">ทีมงานได้รับคำขอแล้วและกำลังตรวจสอบ</div>
                                </div>
                            </div>
                        }
                        else if (returnRequest.Status == 1)
                        {
                            <div class="return-status return-status-approved">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                <div>
                                    <div class="return-status-title">อนุมัติแล้ว</div>
                                    <div class="return-status-desc">คำขอได้รับการอนุมัติ กรุณารอการดำเนินการ</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="return-status return-status-rejected">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                                </svg>
                                <div>
                                    <div class="return-status-title">ไม่อนุมัติ</div>
                                    <div class="return-status-desc">คำขอไม่ได้รับการอนุมัติ สามารถติดต่อแอดมินได้</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<style>
/* Back link */
.back-link { font-size: .875rem; transition: color .15s; }
.back-link:hover { color: #000 !important; }

/* Section titles */
.section-title {
    display: flex; align-items: center; gap: 8px;
    font-size: .9375rem; font-weight: 600; color: #1a1a1a; margin: 0;
}

/* Status badges */
.status-badge {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: .75rem; font-weight: 600;
    padding: 5px 12px; border-radius: 20px;
}
.status-pending  { background: #FFF8E1; color: #8B6000; }
.status-shipping { background: #E3F2FD; color: #0D47A1; }
.status-delivered{ background: #E8F5E9; color: #2E7D32; }
.status-cancelled{ background: #FFEBEE; color: #B71C1C; }

/* Product thumb */
.product-thumb {
    width: 68px; height: 68px; flex-shrink: 0;
    background: #f8f8f8; border: 1px solid #eee;
}
.order-product-row:last-child { border-bottom: 0 !important; }

/* Review button */
.btn-review {
    display: inline-flex; align-items: center; gap: 5px;
    border: 1px solid #ddd; border-radius: 8px;
    padding: 5px 12px; font-size: .8125rem;
    color: #333; text-decoration: none;
    transition: background .15s, border-color .15s;
}
.btn-review:hover { background: #f5f5f5; border-color: #bbb; }

/* Reviewed badge */
.reviewed-badge {
    display: inline-flex; align-items: center; gap: 4px;
    background: #E8F5E9; color: #2E7D32;
    font-size: .75rem; font-weight: 600;
    padding: 3px 10px; border-radius: 20px;
}

/* Stars */
.star-rating { display: flex; gap: 2px; justify-content: flex-end; margin-top: 5px; }

/* Summary rows */
.summary-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: .875rem; }

/* Promo badge */
.promo-badge {
    background: #E8F5E9; color: #2E7D32;
    font-size: .75rem; font-weight: 600;
    padding: 3px 10px; border-radius: 20px;
}

/* Return meta */
.return-label { display: block; font-size: .75rem; color: #888; margin-bottom: 2px; }
.return-value  { font-size: .875rem; font-weight: 500; color: #1a1a1a; }

/* Return status blocks */
.return-status {
    display: flex; align-items: flex-start; gap: 8px;
    border-radius: 10px; padding: 10px 12px;
}
.return-status-title { font-size: .8125rem; font-weight: 600; }
.return-status-desc  { font-size: .75rem; margin-top: 2px; }

.return-status-pending  { background: #FFF8E1; color: #8B6000; }
.return-status-pending  .return-status-desc { color: #9a7000; }
.return-status-approved { background: #E8F5E9; color: #2E7D32; }
.return-status-approved .return-status-desc { color: #388E3C; }
.return-status-rejected { background: #FFEBEE; color: #B71C1C; }
.return-status-rejected .return-status-desc { color: #C62828; }
</style>