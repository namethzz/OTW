@model Project.ViewModels.RegisterViewModel
@{
    Layout = "_AuthLayout";
}

<link rel="stylesheet" href="~/css/globals.css" />
<link rel="stylesheet" href="~/css/styleguide.css" />
<link rel="stylesheet" href="~/css/style.css" />


<main class="auth-wrapper">

    <!-- ฝั่งฟอร์ม -->
    <section class="form-section">
        <div class="form-box">

            <h1>Get Started Now</h1>

            <form asp-action="Register" method="post" class="signup-form">

                <div class="form-group">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" placeholder="Enter your name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="terms">
                    <input asp-for="Terms" />
                    <label asp-for="Terms">
                        I agree to the <a href="#">terms & policy</a>
                    </label>
                </div>
                <span asp-validation-for="Terms" class="text-danger"></span>

                <button type="submit" class="btn-primary">Signup</button>

            </form>

            <p class="login-link">
                Have an account?
                <a asp-action="Login">Sign In</a>
            </p>

        </div>
    </section>

    <!-- ฝั่งรูป -->
    <aside class="image-section">
        <img src="~/img/onthewhey.jpg" />
    </aside>

</main>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}