@model List<Project.Controllers.CartItem>
@{
    Layout = "_Layout";
    ViewData["Title"] = "ตะกร้าสินค้า";
    var total    = Model.Sum(c => c.Subtotal);
    var shipping = total >= 1500 ? 0m : 50m;
    var grandTotal = total + shipping;
    var totalQty = Model.Sum(c => c.Quantity);
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex align-items-center gap-3 mb-5">
        <div>
            <h2 class="fw-bold mb-0" style="font-size:1.5rem;">ตะกร้าสินค้า</h2>
            <p class="text-muted mb-0" style="font-size:.875rem;">
                @if (Model.Any())
                {
                    <span>@totalQty ชิ้น · @Model.Count รายการ</span>
                }
                else
                {
                    <span>ไม่มีสินค้าในตะกร้า</span>
                }
            </p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty state -->
        <div class="empty-state text-center py-5">
            <div class="empty-icon-wrap mx-auto mb-4">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ccc"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
            </div>
            <h5 class="fw-semibold mb-1">ตะกร้าของคุณว่างเปล่า</h5>
            <p class="text-muted mb-4" style="font-size:.875rem;">เริ่มเลือกสินค้าที่คุณชื่นชอบได้เลย</p>
            <a asp-controller="Shop" asp-action="Index" class="btn-shop-now">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
                เลือกซื้อสินค้า
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            <!-- ── ซ้าย: รายการสินค้า ── -->
            <div class="col-lg-8">

                <!-- Free shipping progress -->
                @if (total < 1500)
                {
                    var pct = (int)Math.Min((total / 1500m) * 100, 100);
                    var remain = 1500 - total;
                    <div class="ship-progress-bar mb-4">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#d97706"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="1" y="3" width="15" height="13"/>
                                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                <circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                            <span style="font-size:.8125rem; color:#92400e;">
                                ซื้อเพิ่มอีก <strong>฿@remain.ToString("N0")</strong> รับจัดส่งฟรี!
                            </span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill" style="width:@pct%"></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ship-free-banner mb-4">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16a34a"
                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        คุณได้รับสิทธิ์จัดส่งฟรีแล้ว!
                    </div>
                }

                <!-- Cart items -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    @foreach (var item in Model)
                    {
                        <div class="cart-item">

                            <!-- รูป -->
                            <div class="cart-img-wrap flex-shrink-0">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.ProductName"
                                         style="width:100%;height:100%;object-fit:contain;padding:6px" />
                                }
                                else
                                {
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ddd"
                                         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                                        <circle cx="8.5" cy="8.5" r="1.5"/>
                                        <polyline points="21 15 16 10 5 21"/>
                                    </svg>
                                }
                            </div>

                            <!-- ชื่อ + ราคา/ชิ้น -->
                            <div class="flex-grow-1 min-w-0">
                                <div class="cart-item-name">@item.ProductName</div>
                                <div class="cart-item-price">฿@item.Price.ToString("N2") / ชิ้น</div>
                            </div>

                            <!-- จำนวน -->
                            <div class="qty-control flex-shrink-0">
                                <form asp-controller="Shop" asp-action="UpdateCart" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                    <button type="submit" class="qty-btn">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                    </button>
                                </form>
                                <span class="qty-num">@item.Quantity</span>
                                <form asp-controller="Shop" asp-action="UpdateCart" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                    <button type="submit" class="qty-btn">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                    </button>
                                </form>
                            </div>

                            <!-- ราคารวม -->
                            <div class="cart-subtotal flex-shrink-0">
                                ฿@item.Subtotal.ToString("N2")
                            </div>

                            <!-- ลบ -->
                            <button class="delete-btn flex-shrink-0"
                                    onclick="openDeleteModal(@item.ProductId, '@item.ProductName.Replace("'", "\\'")') ">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"/>
                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                    <path d="M10 11v6M14 11v6"/>
                                    <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                </svg>
                            </button>

                        </div>
                    }
                </div>

                <!-- Back to shop -->
                <div class="mt-3">
                    <a asp-controller="Shop" asp-action="Index"
                       class="d-inline-flex align-items-center gap-2 text-decoration-none text-muted"
                       style="font-size:.875rem; transition:color .15s;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"/>
                        </svg>
                        เลือกซื้อเพิ่ม
                    </a>
                </div>

            </div>

            <!-- ── ขวา: สรุปยอด ── -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top:80px">
                    <div class="card-body p-4">

                        <h5 class="section-title mb-4">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                                <line x1="8" y1="18" x2="21" y2="18"/>
                                <line x1="3" y1="6" x2="3.01" y2="6"/>
                                <line x1="3" y1="12" x2="3.01" y2="12"/>
                                <line x1="3" y1="18" x2="3.01" y2="18"/>
                            </svg>
                            สรุปคำสั่งซื้อ
                        </h5>

                        <div class="summary-row">
                            <span class="text-muted">ยอดสินค้า (@totalQty ชิ้น)</span>
                            <span>฿@total.ToString("N2")</span>
                        </div>
                        <div class="summary-row mb-3">
                            <span class="text-muted">ค่าจัดส่ง</span>
                            @if (shipping == 0)
                            {
                                <span class="free-badge">ฟรี</span>
                            }
                            else
                            {
                                <span>฿@shipping.ToString("N2")</span>
                            }
                        </div>

                        <div class="border-top pt-3 mb-4">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="fw-semibold">ยอดรวมทั้งหมด</span>
                                <span class="fw-bold" style="font-size:1.35rem;">฿@grandTotal.ToString("N2")</span>
                            </div>
                        </div>

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <a asp-controller="Checkout" asp-action="Index" class="btn-checkout w-100 d-flex align-items-center justify-content-center gap-2 text-decoration-none mb-2">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                                    <line x1="1" y1="10" x2="23" y2="10"/>
                                </svg>
                                ดำเนินการชำระเงิน
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               class="btn-checkout w-100 d-flex align-items-center justify-content-center gap-2 text-decoration-none mb-2">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                                    <polyline points="10 17 15 12 10 7"/>
                                    <line x1="15" y1="12" x2="3" y2="12"/>
                                </svg>
                                เข้าสู่ระบบเพื่อชำระเงิน
                            </a>
                            <p class="text-center text-muted mb-0" style="font-size:.8rem;">
                                ยังไม่มีบัญชี?
                                <a asp-controller="Account" asp-action="Register"
                                   class="text-dark fw-semibold">สมัครสมาชิก</a>
                            </p>
                        }

                        <!-- Security note -->
                        <div class="security-note mt-3">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                            ชำระเงินปลอดภัย · เข้ารหัส SSL
                        </div>

                    </div>
                </div>
            </div>

        </div>
    }
</div>

<!-- ══ Delete Modal ══ -->
<div class="modal fade" id="deleteCartModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:360px">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mx-auto mb-3">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#ef4444"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                        <path d="M10 11v6M14 11v6"/>
                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                    </svg>
                </div>
                <h5 class="fw-bold mb-1" style="font-size:1rem;">ลบสินค้าออกจากตะกร้า?</h5>
                <p class="text-muted mb-4" style="font-size:.8125rem;" id="deleteProductName"></p>
                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn-modal-cancel flex-fill"
                            data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="button"
                            class="btn-modal-delete flex-fill"
                            onclick="submitDelete()">ลบออก</button>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="deleteCartForm" asp-controller="Shop" asp-action="RemoveFromCart" method="post">
    <input type="hidden" id="deleteProductId" name="productId" value="" />
</form>

<style>
/* Empty state */
.empty-icon-wrap {
    width: 80px; height: 80px; border-radius: 50%;
    background: #f3f3f3;
    display: flex; align-items: center; justify-content: center;
}
.btn-shop-now {
    display: inline-flex; align-items: center; gap: 8px;
    background: #1a1a1a; color: #fff;
    border-radius: 12px; padding: 12px 24px;
    font-size: .9rem; font-weight: 600;
    text-decoration: none;
    transition: background .15s;
}
.btn-shop-now:hover { background: #333; color: #fff; }

/* Shipping progress */
.ship-progress-bar {
    background: #fefce8;
    border: 1px solid #fde68a;
    border-radius: 12px;
    padding: 12px 16px;
}
.progress-track {
    height: 5px; background: #f3f3f3; border-radius: 20px; overflow: hidden;
}
.progress-fill {
    height: 100%; background: #d97706; border-radius: 20px;
    transition: width .4s ease;
}
.ship-free-banner {
    display: flex; align-items: center; gap: 8px;
    background: #f0fdf4; border: 1px solid #bbf7d0;
    border-radius: 12px; padding: 10px 16px;
    font-size: .8125rem; font-weight: 600; color: #16a34a;
}

/* Cart item row */
.cart-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    border-bottom: 1px solid #f5f5f5;
    transition: background .15s;
}
.cart-item:last-child { border-bottom: 0; }
.cart-item:hover { background: #fafafa; }

.cart-img-wrap {
    width: 72px; height: 72px;
    background: #f8f8f8;
    border: 1px solid #eee;
    border-radius: 10px;
    overflow: hidden;
    display: flex; align-items: center; justify-content: center;
}

.cart-item-name {
    font-size: .875rem; font-weight: 500; color: #1a1a1a;
    display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
    margin-bottom: 3px;
}
.cart-item-price { font-size: .75rem; color: #999; }

/* Qty control */
.qty-control {
    display: flex; align-items: center; gap: 0;
    border: 1px solid #e8e8e8; border-radius: 10px; overflow: hidden;
}
.qty-btn {
    width: 32px; height: 32px;
    background: none; border: none;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: #555;
    transition: background .15s;
}
.qty-btn:hover { background: #f3f3f3; }
.qty-num {
    width: 36px; text-align: center;
    font-size: .875rem; font-weight: 600; color: #1a1a1a;
    border-left: 1px solid #f0f0f0;
    border-right: 1px solid #f0f0f0;
    line-height: 32px;
}

.cart-subtotal {
    font-size: .9rem; font-weight: 600; color: #1a1a1a;
    min-width: 80px; text-align: right;
}

/* Delete button */
.delete-btn {
    width: 32px; height: 32px;
    background: none; border: none;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    color: #ccc; cursor: pointer;
    transition: background .15s, color .15s;
}
.delete-btn:hover { background: #fef2f2; color: #ef4444; }

/* Section title */
.section-title {
    display: flex; align-items: center; gap: 8px;
    font-size: .9375rem; font-weight: 600; color: #1a1a1a; margin: 0;
}

/* Summary */
.summary-row {
    display: flex; justify-content: space-between; align-items: center;
    font-size: .875rem; margin-bottom: 8px;
}
.free-badge {
    background: #E8F5E9; color: #2E7D32;
    font-size: .75rem; font-weight: 600;
    padding: 2px 10px; border-radius: 20px;
}

/* Checkout button */
.btn-checkout {
    background: #1a1a1a; color: #fff;
    border-radius: 12px; padding: 13px;
    font-size: .9375rem; font-weight: 600;
    transition: background .15s;
}
.btn-checkout:hover { background: #333; color: #fff; }

/* Security note */
.security-note {
    display: flex; align-items: center; justify-content: center; gap: 5px;
    font-size: .75rem; color: #bbb;
}

/* Modal */
.delete-icon-wrap {
    width: 60px; height: 60px; border-radius: 50%;
    background: #fff5f5; border: 1px solid #fecaca;
    display: flex; align-items: center; justify-content: center;
}
.btn-modal-cancel {
    background: none; border: 1px solid #e5e5e5;
    border-radius: 10px; padding: 10px;
    font-size: .875rem; color: #555; cursor: pointer;
    transition: background .15s;
}
.btn-modal-cancel:hover { background: #f5f5f5; }
.btn-modal-delete {
    background: #ef4444; border: none; color: #fff;
    border-radius: 10px; padding: 10px;
    font-size: .875rem; font-weight: 600; cursor: pointer;
    transition: background .15s;
}
.btn-modal-delete:hover { background: #dc2626; }
</style>

@section Scripts {
<script>
function openDeleteModal(productId, productName) {
    document.getElementById('deleteProductId').value = productId;
    document.getElementById('deleteProductName').textContent = '"' + productName + '"';
    new bootstrap.Modal(document.getElementById('deleteCartModal')).show();
}
function submitDelete() {
    document.getElementById('deleteCartForm').submit();
}
</script>
}
