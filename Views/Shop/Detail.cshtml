@model Project.Models.Db.Product
@using Project.Models.Db

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.ProductName;

    var related  = ViewBag.Related  as List<Product> ?? new();
    var reviews  = ViewBag.Reviews  as List<Review>  ?? new();
    var avgRating   = (double)(ViewBag.AvgRating  ?? 0.0);
    var reviewCount = (int)(ViewBag.ReviewCount ?? 0);
}

<div class="container py-5">

    <!-- Back -->
    <div class="mb-4">
        <a asp-controller="Shop" asp-action="Index"
           class="back-link text-decoration-none text-muted d-inline-flex align-items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            กลับไปหน้าสินค้า
        </a>
    </div>

    @if (TempData["CartSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
            @TempData["CartSuccess"]
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Product Main -->
    <div class="row g-5 mb-5">

        <!-- รูปสินค้า -->
        <div class="col-lg-5">
            <div class="product-image-wrap rounded-4 d-flex align-items-center justify-content-center overflow-hidden">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.ProductName"
                         class="img-fluid" style="max-height:420px; object-fit:contain;" />
                }
                else
                {
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#ccc"
                         stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                    </svg>
                }
            </div>
        </div>

        <!-- ข้อมูลสินค้า -->
        <div class="col-lg-7">

            @if (Model.Category != null)
            {
                <span class="category-badge mb-3 d-inline-block">@Model.Category.CategoryName</span>
            }

            <h1 class="product-title mb-2">@Model.ProductName</h1>

            <!-- Rating summary -->
            <div class="d-flex align-items-center gap-2 mb-3">
                <div class="star-display">
                    @for (int s = 1; s <= 5; s++)
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24"
                             fill="@(s <= Math.Round(avgRating) ? "#F5A623" : "none")"
                             stroke="#F5A623" stroke-width="1.5"
                             stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                    }
                </div>
                <span class="text-muted" style="font-size:.875rem;">
                    @avgRating.ToString("F1") (@reviewCount รีวิว)
                </span>
            </div>

            <div class="product-price mb-4">฿@Model.Price.ToString("N2")</div>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-muted mb-4" style="font-size:.9375rem; line-height:1.7;">
                    @Model.Description
                </p>
            }

            <!-- Add to Cart -->
            <form asp-controller="Shop" asp-action="AddToCart" method="post"
                  class="d-flex align-items-center gap-3 flex-wrap">
                <input type="hidden" name="productId" value="@Model.ProductId" />

                <div class="qty-wrap d-flex align-items-center">
                    <button type="button" class="qty-btn" onclick="changeQty(-1)">−</button>
                    <input type="number" id="qtyInput" name="quantity" value="1" min="1" max="99"
                           class="qty-input" readonly />
                    <button type="button" class="qty-btn" onclick="changeQty(1)">+</button>
                </div>

                <button type="submit" class="btn-addcart">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    </svg>
                    เพิ่มลงตะกร้า
                </button>
            </form>

        </div>
    </div>

    <!-- Reviews -->
    <div class="row g-4 mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="section-title mb-4">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        รีวิวจากลูกค้า
                        @if (reviewCount > 0)
                        {
                            <span class="review-count-badge">@reviewCount รีวิว</span>
                        }
                    </h5>

                    @if (!reviews.Any())
                    {
                        <p class="text-muted mb-0" style="font-size:.875rem;">ยังไม่มีรีวิวสำหรับสินค้านี้</p>
                    }
                    else
                    {
                        @foreach (var rv in reviews)
                        {
                            <div class="review-item py-3 border-bottom">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <div class="reviewer-avatar">
                                        @(rv.User?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                    <span class="fw-semibold" style="font-size:.875rem;">
                                        @(rv.User?.FullName ?? "ผู้ใช้งาน")
                                    </span>
                                    <span class="text-muted ms-auto" style="font-size:.75rem;">
                                        @rv.CreatedAt.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                                <div class="star-display mb-1">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24"
                                             fill="@(s <= rv.Rating ? "#F5A623" : "none")"
                                             stroke="#F5A623" stroke-width="1.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                        </svg>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(rv.Comment))
                                {
                                    <p class="mb-0 text-muted" style="font-size:.875rem;">@rv.Comment</p>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related.Any())
    {
        <div class="mb-2">
            <h5 class="section-title mb-4">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                </svg>
                สินค้าที่เกี่ยวข้อง
            </h5>
        </div>
        <div class="row g-3">
            @foreach (var p in related)
            {
                <div class="col-6 col-md-3">
                    <a asp-controller="Shop" asp-action="Detail" asp-route-id="@p.ProductId"
                       class="related-card text-decoration-none d-block card border-0 shadow-sm rounded-4 h-100">
                        <div class="related-img-wrap d-flex align-items-center justify-content-center overflow-hidden rounded-top-4">
                            @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.ProductName"
                                     class="img-fluid" style="max-height:140px; object-fit:contain;" />
                            }
                            else
                            {
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ccc"
                                     stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <polyline points="21 15 16 10 5 21"/>
                                </svg>
                            }
                        </div>
                        <div class="card-body p-3">
                            <div class="fw-semibold mb-1" style="font-size:.875rem; color:#1a1a1a;">
                                @p.ProductName
                            </div>
                            <div style="font-size:.875rem; color:#555;">฿@p.Price.ToString("N2")</div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

</div>

<style>
.back-link { font-size:.875rem; transition: color .15s; }
.back-link:hover { color:#000 !important; }

.product-image-wrap {
    background: #f8f8f8;
    border: 1px solid #eee;
    min-height: 340px;
    padding: 2rem;
}

.category-badge {
    background: #EEF2FF; color: #3730A3;
    font-size:.75rem; font-weight:600;
    padding: 4px 12px; border-radius: 20px;
}

.product-title { font-size:1.6rem; font-weight:600; color:#1a1a1a; }
.product-price { font-size:1.75rem; font-weight:700; color:#1a1a1a; }

.star-display { display:flex; gap:2px; }

/* Qty */
.qty-wrap {
    border: 1px solid #ddd; border-radius: 10px; overflow: hidden;
}
.qty-btn {
    background: none; border: none; padding: 8px 14px;
    font-size:1.1rem; cursor:pointer; color:#333;
    transition: background .15s;
}
.qty-btn:hover { background: #f5f5f5; }
.qty-input {
    width: 48px; border: none; text-align: center;
    font-size:.9375rem; font-weight:500; outline:none;
    background: transparent;
}

/* Add to cart */
.btn-addcart {
    display: inline-flex; align-items: center; gap:8px;
    background: #1a1a1a; color:#fff;
    border: none; border-radius: 10px;
    padding: 10px 24px; font-size:.9375rem; font-weight:600;
    cursor: pointer; transition: background .15s;
}
.btn-addcart:hover { background: #333; }

/* Section title */
.section-title {
    display:flex; align-items:center; gap:8px;
    font-size:.9375rem; font-weight:600; color:#1a1a1a; margin:0;
}
.review-count-badge {
    background:#f0f0f0; color:#555;
    font-size:.75rem; font-weight:500;
    padding:2px 10px; border-radius:20px; margin-left:4px;
}

/* Review */
.review-item:last-child { border-bottom:0 !important; }
.reviewer-avatar {
    width:32px; height:32px; border-radius:50%;
    background:#EEF2FF; color:#3730A3;
    display:flex; align-items:center; justify-content:center;
    font-size:.8125rem; font-weight:600; flex-shrink:0;
}

/* Related */
.related-img-wrap { background:#f8f8f8; height:160px; }
.related-card { transition: transform .15s; }
.related-card:hover { transform: translateY(-3px); }
</style>

<script>
function changeQty(delta) {
    const input = document.getElementById('qtyInput');
    const val = parseInt(input.value) + delta;
    if (val >= 1 && val <= 99) input.value = val;
}
</script>
