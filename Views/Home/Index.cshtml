@{
    ViewData["Title"] = "Home Page";
    var products   = ViewBag.Products   as List<Project.Models.Db.Product>  ?? new();
    var categories = ViewBag.Categories as List<Project.Models.Db.Category> ?? new();
    var ratingReviews = ViewBag.ProductReviews as List<Project.Models.Db.Review> ?? new();
    var reviews    = ViewBag.Reviews    as List<Project.Models.Db.Review>   ?? new();
}

<div class="container commerce-storefront">
    @await Html.PartialAsync("~/Views/Shared/Components/UI/_CommerceHero.cshtml", new Project.ViewModels.CommerceHeroViewModel { Categories = categories })
</div>

<!-- ══ TRUST BAR ══ -->
<section class="bg-white py-4 border-bottom">
    <div class="container">
        <div class="row text-center g-3">
            <div class="col-6 col-md-3">
                <svg class="trust-icon" style="color:#2563eb" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
                <div class="trust-label">จัดส่งฟรี เมื่อครบ 1,500 บาท</div>
            </div>
            <div class="col-6 col-md-3">
                <svg class="trust-icon" style="color:#16a34a" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <div class="trust-label">ชำระเงินปลอดภัย</div>
            </div>
            <div class="col-6 col-md-3">
                <svg class="trust-icon" style="color:#d97706" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                <div class="trust-label">ของแท้รับประกัน</div>
            </div>
            <div class="col-6 col-md-3">
                <svg class="trust-icon" style="color:#dc2626" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/>
                </svg>
                <div class="trust-label">คืนสินค้าได้ภายใน 7 วัน</div>
            </div>
        </div>
    </div>
</section>

<!-- ══ สินค้าแนะนำ ══ -->
<section class="container my-5" id="products">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">สินค้าแนะนำ</h2>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-dark btn-sm">ดูทั้งหมด →</a>
    </div>

    @if (!products.Any())
    {
        <div class="text-center py-5 text-muted">
            <p>ยังไม่มีสินค้าในระบบ</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-dark btn-sm">ไปหน้า Shop</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in products)
            {
                var productReviews = ratingReviews.Where(rv => rv.ProductId == p.ProductId).ToList();
                <div class="col-sm-6 col-lg-3">
                    @await Html.PartialAsync("~/Views/Shared/Components/UI/_ProductRevealCard.cshtml", new Project.ViewModels.ProductRevealCardViewModel { Product = p, ReviewCount = productReviews.Count, Rating = productReviews.Any() ? productReviews.Average(rv => rv.Rating) : (double?)null })
                </div>
            }
        </div>
    }
</section>

<!-- ══ รีวิวจากลูกค้า (ข้อมูลจริงจาก DB) ══ -->
<section class="py-5" style="background:#f9f9f7;">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-1">รีวิวจากลูกค้า</h2>
            <p class="text-muted" style="font-size:.9rem;">ความคิดเห็นจริงจากผู้ซื้อที่ได้รับสินค้าแล้ว</p>
        </div>

        @if (!reviews.Any())
        {
            <div class="text-center text-muted py-4">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ccc"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                     class="mb-3 d-block mx-auto">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <p class="mb-0">ยังไม่มีรีวิวในระบบ</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var rv in reviews)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="review-card h-100">

                            <!-- Stars -->
                            <div class="review-stars mb-2">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24"
                                         fill="@(s <= rv.Rating ? "#F5A623" : "none")"
                                         stroke="#F5A623" stroke-width="1.5"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                    </svg>
                                }
                            </div>

                            <!-- Comment -->
                            <p class="review-comment">"@rv.Comment"</p>

                            <!-- Footer -->
                            <div class="review-footer mt-auto">
                                <div class="reviewer-avatar">
                                    @((rv.User?.FullName ?? "?").Substring(0, 1).ToUpper())
                                </div>
                                <div class="min-w-0">
                                    <div class="reviewer-name">@(rv.User?.FullName ?? "ลูกค้า")</div>
                                    @if (rv.Product != null)
                                    {
                                        <div class="reviewer-product text-truncate">@rv.Product.ProductName</div>
                                    }
                                </div>
                                <div class="review-date ms-auto">
                                    @rv.CreatedAt.ToString("dd/MM/yy")
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<style>
/* Trust bar */
.trust-icon { width: 36px; height: 36px; display: block; margin: 0 auto 8px; }
.trust-label { font-size: .85rem; color: #444; }

/* Product card */
.product-card { transition: transform .2s, box-shadow .2s; cursor: pointer; border-radius: 12px; overflow: hidden; }
.product-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,.12) !important; }

/* Category card */
.category-card { transition: transform .2s, box-shadow .2s; cursor: pointer; border-radius: 12px; }
.category-card:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,.1) !important; }

/* Review card */
.review-card {
    background: #fff;
    border-radius: 16px;
    padding: 20px 22px;
    border: 1px solid #efefef;
    display: flex;
    flex-direction: column;
    transition: box-shadow .2s, transform .2s;
}
.review-card:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,.08);
    transform: translateY(-2px);
}
.review-stars { display: flex; gap: 2px; }
.review-comment {
    font-size: .9rem;
    color: #333;
    line-height: 1.6;
    flex: 1;
    margin: 10px 0 16px;
}
.review-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid #f3f3f3;
}
.reviewer-avatar {
    width: 34px; height: 34px;
    border-radius: 50%;
    background: #1a1a1a;
    color: #fff;
    font-size: .75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.reviewer-name    { font-size: .8125rem; font-weight: 600; color: #1a1a1a; }
.reviewer-product { font-size: .75rem; color: #999; margin-top: 1px; }
.review-date      { font-size: .75rem; color: #bbb; white-space: nowrap; }
</style>
