@{
    ViewData["Title"] = "Home Page";
    var products   = ViewBag.Products   as List<Project.Models.Db.Product>  ?? new();
    var categories = ViewBag.Categories as List<Project.Models.Db.Category> ?? new();
    var reviews    = ViewBag.Reviews    as List<Project.Models.Db.Review>   ?? new();
}

<!-- ══ HERO ══ -->
<section class="bg-light py-5 border-top border-bottom mt-5">
    <div class="container px-4 px-md-5">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="display-4 fw-bold">
                    อาหารเสริมแท้ 100%<br>
                    เพื่อสุขภาพที่ดีกว่า
                </h1>
                <p class="text-muted">โปรตีน วิตามิน และผลิตภัณฑ์ดูแลสุขภาพคุณภาพสูง</p>
                <div class="mt-4">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-dark btn-lg me-2">Shop Now</a>
                    <a href="#products" class="btn btn-outline-dark btn-lg">ดูสินค้าทั้งหมด</a>
                </div>
                <div class="d-flex gap-4 mt-5">
                    <div><h4>10,000+</h4><small>ลูกค้าพึงพอใจ</small></div>
                    <div><h4>20+</h4><small>แบรนด์ชั้นนำ</small></div>
                    <div><h4>Fast Delivery</h4><small>จัดส่งทั่วประเทศ</small></div>
                </div>
            </div>
            <div class="col-md-6 text-center">
                <img src="~/img/pexels-pavel-danilyuk-6339725.jpg"
                     class="img-fluid rounded shadow" style="max-height:420px;object-fit:cover" />
            </div>
        </div>
    </div>
</section>

<!-- ══ TRUST BAR ══ -->
<section class="bg-white py-4 border-bottom">
    <div class="container">
        <div class="row text-center g-3">
            <div class="col-6 col-md-3">
                <svg class="trust-icon" style="color:#2563eb" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
                <div class="trust-label">จัดส่งฟรี เมื่อครบ 1,500 บาท</div>
            </div>
            <div class="col-6 col-md-3">
                <svg class="trust-icon" style="color:#16a34a" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <div class="trust-label">ชำระเงินปลอดภัย</div>
            </div>
            <div class="col-6 col-md-3">
                <svg class="trust-icon" style="color:#d97706" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                <div class="trust-label">ของแท้รับประกัน</div>
            </div>
            <div class="col-6 col-md-3">
                <svg class="trust-icon" style="color:#dc2626" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/>
                </svg>
                <div class="trust-label">คืนสินค้าได้ภายใน 7 วัน</div>
            </div>
        </div>
    </div>
</section>

<!-- ══ หมวดหมู่ ══ -->
<section class="container my-5">
    <h2 class="text-center fw-bold mb-4">หมวดหมู่สินค้า</h2>
    <div class="row g-4 justify-content-center">
        @foreach (var cat in categories)
        {
            <div class="col-6 col-md-3">
                <a asp-controller="Shop" asp-action="Index"
                   asp-route-categoryId="@cat.CategoryId"
                   class="text-decoration-none">
                    <div class="card border-0 shadow-sm text-center p-4 h-100 category-card">
                        <div class="mb-3">
                            @if (cat.CategoryName.Contains("พืช"))
                            {
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:block;margin:auto">
                                    <path d="M12 22V12"/><path d="M5 3a7 7 0 0 0 7 7 7 7 0 0 0 7-7"/>
                                </svg>
                            }
                            else
                            {
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:block;margin:auto">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                </svg>
                            }
                        </div>
                        <h6 class="fw-bold mb-1">@cat.CategoryName</h6>
                        <small class="text-muted">@cat.Description</small>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- ══ สินค้าแนะนำ ══ -->
<section class="container my-5" id="products">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">สินค้าแนะนำ</h2>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-dark btn-sm">ดูทั้งหมด →</a>
    </div>

    @if (!products.Any())
    {
        <div class="text-center py-5 text-muted">
            <p>ยังไม่มีสินค้าในระบบ</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-dark btn-sm">ไปหน้า Shop</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in products)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm h-100 product-card">
                        <a asp-controller="Shop" asp-action="Detail" asp-route-id="@p.ProductId">
                            <div style="height:200px;background:#f8f8f8;overflow:hidden" class="position-relative">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" class="w-100 h-100"
                                         style="object-fit:contain;padding:10px" alt="@p.ProductName" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                                            <circle cx="8.5" cy="8.5" r="1.5"/>
                                            <polyline points="21 15 16 10 5 21"/>
                                        </svg>
                                    </div>
                                }
                                <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75">
                                    @p.Category?.CategoryName
                                </span>
                            </div>
                        </a>
                        <div class="card-body d-flex flex-column">
                            <a asp-controller="Shop" asp-action="Detail" asp-route-id="@p.ProductId"
                               class="text-decoration-none text-dark">
                                <h6 class="fw-semibold mb-1" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                                    @p.ProductName
                                </h6>
                            </a>
                            @{
                                var productReviews = (ViewBag.Reviews as List<Project.Models.Db.Review> ?? new())
                                    .Where(r => r.ProductId == p.ProductId).ToList();
                                var avgRating = productReviews.Any() ? productReviews.Average(r => r.Rating) : 0;
                                var reviewCount = productReviews.Count;
                            }
                            <div class="d-flex align-items-center gap-1 mb-2">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24"
                                         fill="@(s <= Math.Round(avgRating) ? "#F5A623" : "none")"
                                         stroke="#F5A623" stroke-width="1.5"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                    </svg>
                                }
                                @if (reviewCount > 0)
                                {
                                    <small class="text-muted ms-1">(@reviewCount)</small>
                                }
                                else
                                {
                                    <small class="text-muted ms-1">ยังไม่มีรีวิว</small>
                                }
                            </div>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fs-6 fw-bold">฿@p.Price.ToString("N0")</span>
                                    <small class="text-muted">เหลือ @p.Stock</small>
                                </div>
                                <form asp-controller="Shop" asp-action="AddToCart" method="post">
                                    <input type="hidden" name="productId" value="@p.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-dark w-100 btn-sm"
                                            @(p.Stock == 0 ? "disabled" : "")>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;vertical-align:middle">
                                            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                                        </svg>
                                        @(p.Stock == 0 ? "สินค้าหมด" : "เพิ่มลงตะกร้า")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

<!-- ══ รีวิวจากลูกค้า (ข้อมูลจริงจาก DB) ══ -->
<section class="py-5" style="background:#f9f9f7;">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-1">รีวิวจากลูกค้า</h2>
            <p class="text-muted" style="font-size:.9rem;">ความคิดเห็นจริงจากผู้ซื้อที่ได้รับสินค้าแล้ว</p>
        </div>

        @if (!reviews.Any())
        {
            <div class="text-center text-muted py-4">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ccc"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                     class="mb-3 d-block mx-auto">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <p class="mb-0">ยังไม่มีรีวิวในระบบ</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var rv in reviews)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="review-card h-100">

                            <!-- Stars -->
                            <div class="review-stars mb-2">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24"
                                         fill="@(s <= rv.Rating ? "#F5A623" : "none")"
                                         stroke="#F5A623" stroke-width="1.5"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                    </svg>
                                }
                            </div>

                            <!-- Comment -->
                            <p class="review-comment">"@rv.Comment"</p>

                            <!-- Footer -->
                            <div class="review-footer mt-auto">
                                <div class="reviewer-avatar">
                                    @((rv.User?.FullName ?? "?").Substring(0, 1).ToUpper())
                                </div>
                                <div class="min-w-0">
                                    <div class="reviewer-name">@(rv.User?.FullName ?? "ลูกค้า")</div>
                                    @if (rv.Product != null)
                                    {
                                        <div class="reviewer-product text-truncate">@rv.Product.ProductName</div>
                                    }
                                </div>
                                <div class="review-date ms-auto">
                                    @rv.CreatedAt.ToString("dd/MM/yy")
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<style>
/* Trust bar */
.trust-icon { width: 36px; height: 36px; display: block; margin: 0 auto 8px; }
.trust-label { font-size: .85rem; color: #444; }

/* Product card */
.product-card { transition: transform .2s, box-shadow .2s; cursor: pointer; border-radius: 12px; overflow: hidden; }
.product-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,.12) !important; }

/* Category card */
.category-card { transition: transform .2s, box-shadow .2s; cursor: pointer; border-radius: 12px; }
.category-card:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,.1) !important; }

/* Review card */
.review-card {
    background: #fff;
    border-radius: 16px;
    padding: 20px 22px;
    border: 1px solid #efefef;
    display: flex;
    flex-direction: column;
    transition: box-shadow .2s, transform .2s;
}
.review-card:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,.08);
    transform: translateY(-2px);
}
.review-stars { display: flex; gap: 2px; }
.review-comment {
    font-size: .9rem;
    color: #333;
    line-height: 1.6;
    flex: 1;
    margin: 10px 0 16px;
}
.review-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid #f3f3f3;
}
.reviewer-avatar {
    width: 34px; height: 34px;
    border-radius: 50%;
    background: #1a1a1a;
    color: #fff;
    font-size: .75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.reviewer-name    { font-size: .8125rem; font-weight: 600; color: #1a1a1a; }
.reviewer-product { font-size: .75rem; color: #999; margin-top: 1px; }
.review-date      { font-size: .75rem; color: #bbb; white-space: nowrap; }
</style>
